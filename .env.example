# Copy this file to .env and fill in real values.
# .env is gitignored — it should NEVER be committed.

# Neon Postgres connection string.
# Get it from https://console.neon.tech → your project → Dashboard → Connection string.
# Format: postgres://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# Session secret for express-session (Day 3).
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Resend API key for magic-link emails (Day 3).
# Get one at https://resend.com/api-keys
RESEND_API_KEY=
