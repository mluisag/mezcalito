# Copy this file to .env and fill in real values.
# .env is gitignored — it should NEVER be committed.

# Neon Postgres connection string.
# Get it from https://console.neon.tech → your project → Dashboard → Connection string.
# Format: postgres://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# Secret used to sign the session cookie (HMAC-SHA256). Day 3.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Resend API key for magic-link emails. Day 3.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Public URL the magic-link verify endpoint should send users back to.
# Local dev (vercel dev): http://localhost:3000
# Production: https://mezcalito.app
APP_URL=http://localhost:3000

# Sender for magic-link emails.
# v1: "Mezcalito <onboarding@resend.dev>" (works immediately, no DNS setup).
# Later: verify mezcalito.app in Resend, switch to "Mezcalito <hello@mezcalito.app>".
EMAIL_FROM=Mezcalito <onboarding@resend.dev>
